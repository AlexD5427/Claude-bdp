# ---------------------------------------------------------------------------
# Variables PÚBLICAS del módulo Evaluaciones para los despliegues de producción.
#
# Vite resuelve estas tres variables al COMPILAR (`vite build`) y las incrusta en
# el JavaScript que descarga el navegador. Por eso solo pueden estar aquí valores
# públicos. Los secretos del backend intermedio (EVALUATIONS_ADMIN_SHARED_SECRET,
# EVALUATIONS_PANEL_PASSPHRASE, EVALUATIONS_SESSION_SECRET) se configuran en
# Vercel como variables de servidor y NUNCA llevan el prefijo VITE_.
#
# Están versionadas a propósito: así un despliegue nuevo funciona sin depender de
# que alguien recuerde escribir tres variables en un panel. Si el mismo nombre
# existe en Vercel → Settings → Environment Variables, el valor de Vercel MANDA
# sobre este archivo; conviene no duplicarlas allí.
#
# Documentación: docs/evaluations/REPARACION_2026-07.md §2 y §3.
# ---------------------------------------------------------------------------

# Origen de datos del módulo Evaluaciones (solo de este módulo).
VITE_ASSESSMENTS_PROVIDER=google-apps-script

# URL /exec del Web App de Apps Script de Evaluaciones (libro exclusivo del
# módulo). Es un endpoint público: las acciones administrativas exigen firma.
VITE_EVALUATIONS_API_URL=https://script.google.com/macros/s/AKfycbz3_hVmzR6OQBSsW6yCLjONrXiaYh26aFATVA8z5W6960l-9_TYD0XIj-O6JmfyKMxFpg/exec

# Endpoint del backend intermedio que firma las operaciones administrativas.
VITE_EVALUATIONS_ADMIN_API_URL=/api/evaluations/admin
