{
  "name": "bdp-talent-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Dashboard de Evaluaci\u00f3n de Talento RR.HH. con est\u00e9tica Liquid Glass",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
