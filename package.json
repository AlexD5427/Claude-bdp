    "test": "vitest run",
    "test:watch": "vitest",
    "backend:check": "node scripts/evaluaciones-backend-check.mjs",
    "doc:check": "node scripts/documentacion-backend-check.mjs",
    "doc:qa": "node qa/visual-documentacion.mjs"
  },
  "dependencies": {
