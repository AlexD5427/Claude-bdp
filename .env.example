# ---------------------------------------------------------------------------
# Configuración del despliegue (ejemplo).
#
# Cópialo a `.env.local` para probar en tu equipo, o define estas variables en
# el proyecto de Vercel para producción. NUNCA subas `.env.local` al repositorio.
#
# Solo las variables con prefijo `VITE_` llegan al navegador, así que **nada de
# lo que esté aquí puede considerarse secreto**: cualquiera que abra la
# aplicación puede leerlo. Las llaves y los secretos de verdad viven en las
# propiedades de cada proyecto de Apps Script.
# ---------------------------------------------------------------------------


# ===========================================================================
# LA CUENTA DE GOOGLE
#
# El sistema no tiene un backend propio: su base de datos son libros de Google
# Sheets y su servidor son proyectos de Apps Script publicados como aplicación
# web. Estas cuatro variables son las que permiten apuntar a OTRA cuenta de
# Google sin tocar el código.
#
# Dejarlas sin definir es lo normal: entonces manda lo escrito en
# `src/config/google.ts`. Una variable con una dirección mal formada se ignora
# y se avisa en Configuración → Integraciones, en lugar de romper la aplicación.
#
# El procedimiento completo de migración está en
# `docs/migracion/MIGRACION_CUENTA_GOOGLE.md`; la lista de lo que hay que mover,
# en `docs/migracion/INVENTARIO.md`. Para comprobar el resultado:
#
#     npm run migracion:verificar -- --talento=… --documentacion=… --evaluaciones=…
# ===========================================================================

# Aplicación web del backend del talento: postulantes, comparador, perfiles,
# perfiles de cargo, procesos, referencias y el acceso por perfil. Es el
# endpoint del que depende que la aplicación arranque.
# VITE_SCRIPT_URL=https://script.google.com/macros/s/AKfycb…/exec

# Aplicación web del backend de Documentación (proyecto y libro APARTE del
# talento). Cada navegador puede guardar la suya en «Documentación →
# Configuración → Conexión» y esa manda; esto es lo que usa un equipo que nunca
# la configuró, y lo que evita que las cinco personas del área tengan que
# pegarla a mano tras una migración.
# VITE_DOCUMENTACION_URL=https://script.google.com/macros/s/AKfycb…/exec

# Identificador del despliegue de Evaluaciones — el trozo «AKfycb…» de la URL,
# sin `https://` ni `/exec`. Solo sirve de respaldo para los enlaces de
# evaluación compartidos ANTES de que el enlace llevara dentro su despliegue.
# VITE_EVALUACIONES_DESPLIEGUE=AKfycb…

# Dominio de Workspace, únicamente si el despliegue de Evaluaciones es de la
# forma `https://script.google.com/a/macros/MI-DOMINIO/s/AKfycb…/exec`.
# VITE_EVALUACIONES_DOMINIO=midominio.gob.bo


# ===========================================================================
# MÓDULO DE EVALUACIONES · conexión de trabajo
#
# La conexión que usa el reclutador se configura desde la propia interfaz
# («Evaluaciones → Conexión») y se guarda en el navegador. Estas dos variables
# solo dan el valor inicial para un equipo recién configurado.
# ===========================================================================

# URL `…/exec` del Web App de Evaluaciones. Tiene que ser absoluta: una ruta
# relativa se rechaza con un mensaje explícito en lugar de usarse.
# VITE_EVALUACIONES_URL=https://script.google.com/macros/s/AKfycb…/exec

# Llave de administración (propiedad `EV_ADMIN_KEY` del proyecto de Apps
# Script). Definirla aquí la incrusta en el paquete del navegador; es aceptable
# para un equipo de trabajo compartido y no lo es para un sitio público. Lo
# habitual es dejarla vacía y pegarla una vez en cada equipo.
# VITE_EVALUACIONES_LLAVE=


# ===========================================================================
# ORIGEN DE DATOS DE PROCESOS (ProcessOS)
# ===========================================================================

# mock               → datos de demostración locales, plenamente funcionales
# google-apps-script → el backend real de Apps Script
# supabase           → NO implementado (solo el contrato)
VITE_DATA_PROVIDER=mock


# ===========================================================================
# BACKENDS FUTUROS
# ===========================================================================

# Supabase no está implementado: sin esquema aprobado y credenciales, la bandera
# solo habilita un contrato vacío.
VITE_FLAG_SUPABASE=false
