# ---------------------------------------------------------------------------
# Environment configuration (example).
# Copy to `.env.local` and adjust. NEVER commit real secrets or `.env.local`.
# Only VITE_-prefixed variables are exposed to the browser; do NOT put
# privileged secrets (service-role keys, R2 keys, Apps Script tokens) here.
# ---------------------------------------------------------------------------

# Active data provider for ProcessOS / AssessmentOS.
#   mock               → fully functional local demo data (default)
#   google-apps-script → the live Google Apps Script backend
#   supabase           → NOT implemented (contract only)
VITE_DATA_PROVIDER=mock

# Data provider for the Evaluaciones module ONLY. Lets the new assessment backend
# be rolled out independently from ProcessOS. Inherits VITE_DATA_PROVIDER when
# unset. The module always shows which source is active on screen.
#   mock               → seeded demo data via MockAssessmentService (default)
#   google-apps-script → the normalized Evaluaciones API (apps-script/evaluations)
# VITE_ASSESSMENTS_PROVIDER=google-apps-script

# Public URL of the Evaluaciones Apps Script Web App (…/exec).
# This is a PUBLIC endpoint, NOT a secret: server-side secrets live in the Apps
# Script project's Script Properties. Falls back to SCRIPT_URL when unset.
# VITE_EVALUATIONS_API_URL=https://script.google.com/macros/s/AKfycb…/exec

# Endpoint that signs ADMIN operations (the serverless backend in `api/`).
# Admin calls can never be authorized from the browser, so they go through this
# intermediate backend, which holds the shared secret. Defaults to
# `/api/evaluations/admin` whenever the Apps Script provider is active.
#   <a URL>  → use that endpoint (functions deployed elsewhere)
#   direct   → no proxy; call Apps Script directly. ONLY valid when the backend
#              runs in `google_identity` mode (real Google Workspace session).
# VITE_EVALUATIONS_ADMIN_API_URL=/api/evaluations/admin

# --- Intermediate backend (SERVER-ONLY — never VITE_-prefixed) --------------
# Set these in the Vercel project (Settings → Environment Variables). They are
# read by `api/evaluations/*.ts` and never reach the browser bundle.
#
# EVALUATIONS_APPS_SCRIPT_URL     …/exec of the Evaluaciones Web App.
# EVALUATIONS_ADMIN_SHARED_SECRET ≥32 chars. MUST match the Apps Script property
#                                 with the same name. Rotate via
#                                 EVALUATIONS_ADMIN_SHARED_SECRET_NEXT there.
# EVALUATIONS_PANEL_PASSPHRASE    ≥12 chars. What recruiters type once to open
#                                 the admin session.
# EVALUATIONS_SESSION_SECRET      ≥32 chars. Signs the session cookie.
# EVALUATIONS_ALLOWED_ORIGINS     Optional, comma-separated extra origins.
#
# Generate the secrets with:  openssl rand -base64 48

# Optional debounced autosave in the assessment builder (OFF by default).
# The manual "Guardar borrador" button is always available and autosave never
# publishes.
VITE_FLAG_ASSESSMENTS_AUTOSAVE=false

# --- Advanced question-type feature flags (OFF by default) ------------------
# These enable typed extension contracts that are NOT production-ready.
VITE_FLAG_ADVANCED_SIMULATIONS=false
VITE_FLAG_CODE_QUESTIONS=false
VITE_FLAG_SPREADSHEET_SIM=false
VITE_FLAG_INTERACTIVE_VIDEO=false

# --- Future backends (not implemented without approved schema + creds) ------
VITE_FLAG_SUPABASE=false
VITE_FLAG_CANDIDATE_PORTAL=false

# The Google Apps Script Web App endpoint is currently a build-time constant in
# src/constants.ts (SCRIPT_URL). If you externalize it, expose it here as a
# public URL (NOT a secret). Server-side Apps Script secrets stay in Apps Script.
# VITE_SCRIPT_URL=

# --- Future Supabase / Cloudflare R2 (server-side only; never VITE_-prefixed) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server only — never ship to the browser
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=            # server only
# R2_SECRET_ACCESS_KEY=        # server only
