# BDP ATS — client environment (Vite). Only VITE_-prefixed vars reach the
# browser bundle. NEVER put privileged secrets here.

# Data source for ProcessOS/AssessmentOS: "apps-script" (default) or "mock".
VITE_DATA_MODE=apps-script

# Force the local mock provider regardless of data mode (offline/dev).
VITE_ENABLE_MOCKS=false

# Future Supabase backend (interface boundaries only; not implemented).
VITE_ENABLE_SUPABASE=false

# Feature flags.
VITE_ENABLE_ASSESSMENT_IMPORT=true
VITE_ENABLE_ADVANCED_SIMULATIONS=false
VITE_ENABLE_ASSESSMENT_ANALYTICS=true

# Optional override for the Apps Script web-app URL. When omitted, the value in
# src/constants.ts (SCRIPT_URL) is used. This is a PUBLIC web-app endpoint, not
# a secret.
# VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
